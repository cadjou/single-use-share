{
    "name": "singleuseshare",
    "description": "Filigrane à la volée pour les partages Nextcloud",
    "version": "0.1.0",
    "license": "AGPL-3.0-or-later",
    "private": true,
    "scripts": {
        "build": "webpack --node-env production --config webpack.config.js",
        "dev": "webpack --node-env development --config webpack.config.js",
        "watch": "webpack --node-env development --progress --watch --config webpack.config.js",
        "test:e2e": "cypress run",
        "test:e2e:open": "cypress open",
        "lint": "eslint src"
    },
    "dependencies": {
        "@nextcloud/axios": "^2.5.0",
        "@nextcloud/files": "^3.10.0",
        "@nextcloud/l10n": "^3.1.0",
        "@nextcloud/router": "^3.0.1",
        "@nextcloud/vue": "^8.11.1",
        "@vue/web-component-wrapper": "^1.3.0",
        "vue": "^2.7.16"
    },
    "devDependencies": {
        "@nextcloud/webpack-vue-config": "^6.0.1",
        "cypress": "^13.13.0",
        "eslint": "^8.57.0"
    },
    "browserslist": [
        "extends @nextcloud/browserslist-config"
    ],
    "engines": {
        "node": "^20.0.0",
        "npm": "^9.0.0"
    }
}
